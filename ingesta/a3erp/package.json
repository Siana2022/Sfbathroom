{
  "name": "a3erp-ingesta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "diario": "tsx --env-file=.env src/vuelo.ts --modo diario",
    "diario:sf": "tsx --env-file=.env src/vuelo.ts --modo diario --empresa SF",
    "diario:fux": "tsx --env-file=.env src/vuelo.ts --modo diario --empresa FUX",
    "diario:dot": "tsx --env-file=.env src/vuelo.ts --modo diario --empresa DOT",
    "reconciliacion": "tsx --env-file=.env src/vuelo.ts --modo reconciliacion --empresa SF",
    "reconciliacion:fux": "tsx --env-file=.env src/vuelo.ts --modo reconciliacion --empresa FUX",
    "reconciliacion:dot": "tsx --env-file=.env src/vuelo.ts --modo reconciliacion --empresa DOT",
    "manual": "tsx --env-file=.env src/vuelo.ts --desde 2024-01-01 --hasta 2026-09-22 --empresa SF",
    "manual:agosto": "tsx --env-file=.env src/vuelo.ts --desde 2026-08-01 --hasta 2026-08-31 --empresa SF",
    "diag:esquema": "node --env-file=.env diag-esquema.mjs",
    "maestros:sf": "tsx --env-file=.env src/vuelo-maestros.ts --empresa SF",
    "maestros:fux": "tsx --env-file=.env src/vuelo-maestros.ts --empresa FUX",
    "maestros:dot": "tsx --env-file=.env src/vuelo-maestros.ts --empresa DOT",
    "maestros:todos": "npm run maestros:sf && npm run maestros:fux && npm run maestros:dot",
    "articulos:sf": "tsx --env-file=.env src/vuelo-articulos.ts --empresa SF",
    "articulos:fux": "tsx --env-file=.env src/vuelo-articulos.ts --empresa FUX",
    "articulos:dot": "tsx --env-file=.env src/vuelo-articulos.ts --empresa DOT",
    "articulos:todos": "npm run articulos:sf && npm run articulos:fux && npm run articulos:dot",
    "proveedores:sf": "tsx --env-file=.env src/vuelo-proveedores.ts --empresa SF",
    "proveedores:fux": "tsx --env-file=.env src/vuelo-proveedores.ts --empresa FUX",
    "proveedores:dot": "tsx --env-file=.env src/vuelo-proveedores.ts --empresa DOT",
    "proveedores:todos": "npm run proveedores:sf && npm run proveedores:fux && npm run proveedores:dot",
    "transporte:sf": "tsx --env-file=.env src/vuelo-transporte.ts --empresa SF",
    "transporte:fux": "tsx --env-file=.env src/vuelo-transporte.ts --empresa FUX",
    "transporte:dot": "tsx --env-file=.env src/vuelo-transporte.ts --empresa DOT",
    "transporte:todos": "npm run transporte:sf && npm run transporte:fux && npm run transporte:dot",
    "stock:sf": "tsx --env-file=.env src/vuelo-stock.ts --empresa SF",
    "stock:fux": "tsx --env-file=.env src/vuelo-stock.ts --empresa FUX",
    "stock:dot": "tsx --env-file=.env src/vuelo-stock.ts --empresa DOT",
    "stock:todos": "npm run stock:sf && npm run stock:fux && npm run stock:dot"
  },
  "dependencies": {
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
