# Base de datos SQL Server (A3ERP)
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Empresa a cargar (SF, DOT, FUX)
EMPRESA_CODIGO=SF

# Ventana móvil en días (retro-fechadas y ediciones de los últimos N días)
VENTANA_DIAS=45

# Límite inferior del histórico (primera carga / reconciliación)
PERIODO_START=2022-01-01

# Tamaño de lote para escrituras a Supabase
LOTE_SIZE=500