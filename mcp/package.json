{
  "name": "sfbathroom-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server de solo lectura para consultar los datos de sfbathroom BI (Supabase) desde Claude.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "serve:http": "tsx src/serve-http.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.js && printf '{\\\"type\\\":\\\"commonjs\\\"}' > dist/package.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "inspector": "node --import tsx_modules --experimental-strip-types src/index.ts -- --inspect 2>/dev/null || npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
